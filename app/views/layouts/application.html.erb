<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "The Cocktail App" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="The Cocktail App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <meta property="og:title" content="The Cocktail App">
    <meta property="og:type" content="website">
    <meta property="og:image" content="<%= image_url("og-share.jpg") %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:image" content="<%= image_url("og-share.jpg") %>">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=M+PLUS+Rounded+1c:wght@700&family=Righteous&family=Yellowtail&display=swap">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app <%= "app--hosts-off" if hosts_hidden? %>" data-controller="hosts" data-hosts-off-class="app--hosts-off" data-action="turbo:before-cache@document->hosts#reopenDialogues">
    <header class="site-header">
      <div class="container site-header__inner">
        <%= link_to root_path, class: "logo" do %>
          <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
            <defs>
              <linearGradient id="logoSun" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#ffd166"/>
                <stop offset="0.55" stop-color="#ff9a7a"/>
                <stop offset="1" stop-color="#ff5fa2"/>
              </linearGradient>
            </defs>
            <circle cx="20" cy="20" r="18" fill="url(#logoSun)"/>
            <path d="M3 25h34M4.5 29.5h31M7.5 34h25" stroke="#0f0a28" stroke-width="2.4"/>
            <path d="M11 10h18c0 5.5-4 9-9 9s-9-3.5-9-9z" fill="#0f0a28"/>
            <path d="M20 19v8" stroke="#0f0a28" stroke-width="2.6"/>
          </svg>
          <span class="logo__words">
            <span class="logo__text">The Cocktail App</span>
            <span class="logo__jp" lang="ja" aria-hidden="true">カクテル・アプリ</span>
          </span>
        <% end %>

        <% if authenticated? %>
          <div class="session">
            <span class="session__email"><%= Current.user.email_address %></span>
            <%= button_to "Log out", session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
          </div>
        <% end %>
      </div>
    </header>

    <% if notice.present? || alert.present? %>
      <div class="container flashes">
        <% if notice.present? %>
          <p class="flash flash--notice" role="status">
            <span class="flash__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
            <span class="flash__text"><%= notice %></span>
            <span class="flash__tag" lang="ja" aria-hidden="true">サクセス</span>
          </p>
        <% end %>
        <% if alert.present? %>
          <p class="flash flash--alert" role="alert">
            <span class="flash__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 6v8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="12" cy="18.5" r="1.8" fill="currentColor"/></svg></span>
            <span class="flash__text"><%= alert %></span>
            <span class="flash__tag" lang="ja" aria-hidden="true">エラー</span>
          </p>
        <% end %>
      </div>
    <% end %>

    <%= yield %>

    <footer class="site-footer">
      <% if authenticated? %>
        <%= render "shared/skyline" %>
      <% end %>
      <div class="site-footer__bar">
        <button class="hosts-toggle" type="button" data-hosts-target="toggle" data-action="hosts#toggle">
          <%= hosts_hidden? ? "Show hosts" : "Hide hosts" %>
        </button>
        <span lang="ja" aria-hidden="true">シティ・ポップ ★ カクテル ★ 1986</span>
      </div>
    </footer>
  </body>
</html>
