<main class="main" id="main">
  <div class="container">
    <div class="page-head">
      <div>
        <p class="kicker" lang="ja" aria-hidden="true">カクテル・コレクション</p>
        <h1 class="page-title">Cocktails</h1>
      </div>
      <%= link_to new_cocktail_path, class: "btn btn--primary btn--lg" do %>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
        New cocktail
      <% end %>
    </div>

    <%# Only the stations swap this frame; every other link inside breaks out to the full page %>
    <%= turbo_frame_tag "cocktails", target: "_top", data: { controller: "mood-filter", action: "turbo:before-frame-render->mood-filter#releaseFocus turbo:frame-render->mood-filter#restoreFocus" } do %>
      <% if @cocktails.any? %>
        <%= host_dialogue :reina, :curious, "What are we mixing tonight?" %>
      <% elsif @mood %>
        <%= host_dialogue :reina, :surprise, "#{@mood.titleize}? Nobody's poured that one yet." %>
      <% else %>
        <%= host_dialogue :mika, :fun, "No cocktails yet? Let's fix that, I'm thirsty!" %>
      <% end %>

      <% if Cocktail.exists? %>
        <nav class="mood-tuner" aria-label="Filter by mood">
          <div class="mood-tuner__head">
            <p class="mood-tuner__label"><span class="mood-tuner__jp" lang="ja" aria-hidden="true">ムード・チューナー</span>Mood</p>
            <p class="mood-tuner__now">Now playing: <strong><%= @mood ? @mood.titleize : "All moods" %></strong></p>
          </div>
          <div class="mood-tuner__dial">
            <ul class="mood-tuner__stations" role="list" data-mood-filter-target="stations">
              <li><%= link_to "All", cocktails_path, class: "mood-tuner__station", aria: { current: ("page" unless @mood) }, data: { turbo_frame: "cocktails", turbo_action: "advance" } %></li>
              <% mood_options.each do |label, mood| %>
                <li><%= link_to label, cocktails_path(mood:), class: "mood-tuner__station", aria: { current: ("page" if mood == @mood) }, data: { turbo_frame: "cocktails", turbo_action: "advance" } %></li>
              <% end %>
            </ul>
          </div>
        </nav>
      <% end %>

      <% if @cocktails.any? %>
        <ul class="cocktail-grid" role="list">
          <% @cocktails.each do |cocktail| %>
            <li>
              <article class="cocktail-card">
                <%= render "art", cocktail: cocktail, css_class: "cocktail-card__art" %>
                <div class="cocktail-card__body">
                  <h2 class="cocktail-card__title">
                    <%= link_to cocktail.name, cocktail, class: "cocktail-card__link" %>
                  </h2>
                  <div class="cocktail-card__meta">
                    <span class="badge badge--<%= cocktail.difficulty %>"><%= cocktail.difficulty %></span>
                    <span class="cocktail-card__author">by <%= cocktail.user.email_address %></span>
                    <span class="cocktail-card__mood"><%= cocktail.mood.titleize %></span>
                  </div>
                </div>
              </article>
            </li>
          <% end %>
        </ul>
      <% elsif @mood %>
        <div class="mood-empty">
          <p class="mood-empty__title">Nothing on this station yet.</p>
          <p class="mood-empty__text">No cocktails match <strong><%= @mood.titleize %></strong>. Tune into another mood or add the first one.</p>
          <div class="mood-empty__actions">
            <%= link_to "Show all moods", cocktails_path, class: "btn btn--secondary btn--sm", data: { turbo_frame: "cocktails", turbo_action: "advance" } %>
            <%= link_to "New cocktail", new_cocktail_path, class: "btn btn--primary btn--sm" %>
          </div>
        </div>
      <% else %>
        <div class="empty-state">
          <%= image_tag "extras/empty-state.webp", class: "empty-state__img", alt: "" %>
          <h2 class="empty-state__title">No cocktails yet.</h2>
          <p class="empty-state__text">The bar is open and the playlist is ready. Add the first recipe to get the party started.</p>
          <%= link_to new_cocktail_path, class: "btn btn--primary btn--lg" do %>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            New cocktail
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</main>
