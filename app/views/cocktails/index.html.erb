<h1>Cocktails</h1>

<%= link_to "New cocktail", new_cocktail_path %>

<% if @cocktails.any? %>
  <ul>
    <% @cocktails.each do |cocktail| %>
      <li>
        <%= link_to cocktail.name, cocktail %>
        (<%= cocktail.difficulty %>) by <%= cocktail.user.email_address %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No cocktails yet.</p>
<% end %>
